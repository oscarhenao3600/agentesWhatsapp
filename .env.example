# ===================================================================
# PLANTILLA DE CONFIGURACIÓN Y VARIABLES DE ENTORNO - AGENTES WHATSAPP
# Copia este archivo como .env y completa tus credenciales:
# cp .env.example .env
# ===================================================================

# Perfil activo: 'development' (PC local) o 'production' (Servidor)
NODE_ENV=production

# Nombre del proyecto para Docker Compose
COMPOSE_PROJECT_NAME=agentes_whatsapp

# ===================================================================
# PUERTOS DE SERVICIOS (Convivencia sin conflicto con FormatosCuentas)
# ===================================================================
# Puerto externo para acceder al Panel Web (Frontend Nginx)
FRONTEND_PORT=8090

# Puerto del servicio Backend Node.js
BACKEND_PORT=4050

# Puerto externo para conectar MongoDB Compass / herramientas de BD
MONGO_EXTERNAL_PORT=48160

# ===================================================================
# CONEXIÓN A BASE DE DATOS MONGODB
# ===================================================================
# --- [OPCIÓN 1: PRODUCCIÓN DOCKER (Raspberry Pi)] ---
MONGODB_URI=mongodb://mongodb:27017/agentes_whatsapp

# --- [OPCIÓN 2: DESARROLLO LOCAL WINDOWS (npm run dev)] ---
# MONGODB_URI=mongodb://localhost:48160/agentes_whatsapp

# --- [OPCIÓN 3: MONGODB ATLAS CLOUD (Ahorro ~350MB de RAM en la Pi)] ---
# MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.xxxxx.mongodb.net/agentes_whatsapp?retryWrites=true&w=majority

# ===================================================================
# SEGURIDAD Y AUTENTICACIÓN
# ===================================================================
# Clave Secreta JWT para firma de tokens (Cambiar en producción)
JWT_SECRET=tu_secreto_super_seguro_aqui

# Credenciales del Administrador Principal (Cambiar antes de exponer a internet)
ADMIN_USERNAME=oscarhenao
ADMIN_PASSWORD=cambia_esta_clave_por_una_segura

# Permitir registro público de nuevos clientes ('true' o 'false' para que solo el Admin cree cuentas)
ALLOW_PUBLIC_REGISTER=true

# Clave de encriptación AES-256 (DEBE tener exactamente 32 caracteres)
ENCRYPTION_KEY=clave_secreta_de_32_caracteres_min

# ===================================================================
# INTELIGENCIA ARTIFICIAL (Google Gemini)
# ===================================================================
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# ===================================================================
# WHATSAPP CLOUD API (Meta Developers - Opcional)
# ===================================================================
WHATSAPP_TOKEN=tu_token_de_meta_aqui
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id_aqui
WHATSAPP_VERIFY_TOKEN=tu_token_de_verificacion_webhook

# Número de WhatsApp del Administrador para recibir alertas de fallas técnicas
ADMIN_ALERT_PHONE=573113414361

